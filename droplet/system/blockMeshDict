FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1;

// Create a square domain 18x18 mm. y-dimension is removed by "empty" condition. Change y length so it is equal to the side of one cell (0.0018 / number of cells in z).

vertices
(
    ( -0.040 0 0) //Vertex 0
    (  0.040 0 0) //Vertex 1
    (  0.040  0.00005625 0) //Vertex 2
    ( -0.040  0.00005625 0) //Vertex 3
    ( -0.040 0 0.010) //Vertex 4
    (  0.040 0 0.010) //Vertex 5
    (  0.040  0.00005625 0.040) //Vertex 6
    ( -0.040  0.00005625 0.040) //Vertex 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (490	1 160) simpleGrading (1 1 1)// Reducing overall mesh since snappyHexMesh will refine the important bits 
);

edges
(
);

boundary
(
    top
    {
    	type patch;
    	faces
    	(
    		(4 5 6 7)
    	);
    }

    bottom
    {
    	type patch;
    	faces
    	(
     		(3 2 1 0)
     	);
    }

    sideRight
    {
    	type patch; 
    	faces
    	(
     		(1 2 6 5)
    	);
    }
    
    sideLeft
    {
    	type patch;
    	faces
    	(
     		(0 4 7 3)
    	);
    }
    
    front
    {
    	type empty;
    	faces
    	(
     		(0 1 5 4)
     	);
    }

    back
    {
        type empty;
        faces
        (
                (3 7 6 2)
        );
    }


);

