FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

pointSync false;

patches
(
    {
        name front;
        patchInfo
        {
            type empty;
        }
        constructFrom patches;
        patches (frontback);
        selection
        (
            {
                action include;
                source normal;
                normal (0 -1 0);
                tolerance 10;
            }
        );
    }
    {
        name back;
        patchInfo
        {
            type empty;
        }
        constructFrom patches;
        patches (frontback);
        selection
        (
            {
                action include;
                source normal;
                normal (0 1 0);
                tolerance 10;
            }
        );
    }
);;
