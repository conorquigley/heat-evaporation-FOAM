FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//Just dummy entries, don't worry

application     laplacianFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         10;

deltaT          0.005;

writeControl    timeStep;

writeInterval   2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression none;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

loadFromFiles   true;

functions
{
    dropletFlux
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             true;
        writeFields     false;
        regionType      patch;
        name            dropletSurface;
        operation       areaNormalIntegrate;
        fields          (flux);
    }
}

