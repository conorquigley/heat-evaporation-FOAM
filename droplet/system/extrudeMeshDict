FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}

constructFrom patch;
sourceCase ".";
sourcePatches ( front );
sourceFaceZones ();

exposedPatchName back;

flipNormals false;

extrudeModel linearNormal;

nLayers 1;

expansionRatio 1.0;

linearNormalCoeffs
{
    thickness 0.00005625;
}

mergeFaces false;
