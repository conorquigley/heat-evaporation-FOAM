FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      C;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -2 0 0 0 0 0];

Csat            0.0173;  // kg/m^3
Cinf            0.0086;  // kg/m^3

internalField   uniform $Cinf;

boundaryField
{
    dropletSurface
    {
        type            fixedValue;
        value           uniform $Csat;   // saturation vapour concentration at the droplet surface temperature
    }

    bottom
    {
        type            zeroGradient;    // dry substrate outside the droplet footprint: impermeable, no vapour flux into the solid
    }

    top
    {
        type            fixedValue;
        value           uniform $Cinf;   // far-field ambient concentration — domain is wide enough here to stand in for infinity
    }

    sideLeft
    {
        type            fixedValue;
        value           uniform $Cinf;
    }

    sideRight
    {
        type            fixedValue;
        value           uniform $Cinf;
    }

    frontback
    {
        type            empty;           // 2D pseudo-domain, no physical BC needed
    }
}
